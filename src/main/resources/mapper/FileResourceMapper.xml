<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ylmao.admin.mapper.FileResourceMapper">

    <select id="selectByIdIncludeDeleted" resultType="com.ylmao.admin.entity.FileResource">
        SELECT * FROM sys_file WHERE file_id = #{fileId}
    </select>

    <update id="softDeleteByIds">
        UPDATE sys_file
        SET is_del = 1, delete_time = #{deleteTime}
        WHERE is_del = 0 AND file_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
